    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
